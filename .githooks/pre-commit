#!/bin/sh
# Runs the non-CI-only commands in .claude/checks.json, and nothing else.
set -e

echo "→ swift format lint"
git ls-files -z '*.swift' | xargs -0 swift format lint --strict

echo "→ swift build"
swift build

echo "→ coverage (CI's coverage job, minus the upload)"
python3 .claude/checks/ci-jobs.py --skip-ci-only coverage

echo "✓ All pre-commit checks passed"
