{
  "version": 1,
  "commands": [
    {
      "run": "git ls-files -z '*.swift' | xargs -0 swift format lint --strict",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "swift build",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "python3 .claude/checks/ci-jobs.py --skip-ci-only coverage",
      "timeout": "30m",
      "dir": "."
    }
  ]
}
