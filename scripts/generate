#!/bin/sh
# Regenerate the client from openapi.json with the pinned generator
# (Decision qualithm/pm#2394). Never edit Sources/QualithmPlatform/Generated/
# by hand: CI's Generated Drift job reruns this and fails on any difference.
set -eu

IMAGE="openapitools/openapi-generator-cli:v7.26.0@sha256:a304ddf1e2e5f24f68fa3153568d6174cea4959d09aa8e3db6d526fd0782326d"
OUT=Sources/QualithmPlatform/Generated

cd "$(dirname "$0")/.."
rm -rf .generated "$OUT"
docker run --rm --user "$(id -u):$(id -g)" -v "$PWD:/local" "$IMAGE" \
  generate --config /local/openapi-generator.yaml --skip-validate-spec >/dev/null
# Only the sources ship; the generator's package manifest and docs stay out.
mkdir -p "$(dirname "$OUT")"
mv .generated/Sources/QualithmPlatform "$OUT"
rm -rf .generated
# The generator documents a parameter by its local name, not its label, which
# fails the DocC build.
f="$OUT/Infrastructure/JSONDataEncoding.swift"
sed 's|/// - parameter urlRequest: The request|/// - parameter request: The request|' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
# It also documents a return value on methods that return Void, which DocC rejects.
find "$OUT/APIs" -name '*.swift' | while read -r f; do
  grep -v '^ *- returns: Void$' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
done
# Generated code follows the generator's style, not the repo's.
find "$OUT" -name '*.swift' | sort | while read -r f; do
  { echo "// swift-format-ignore-file"; cat "$f"; } > "$f.tmp" && mv "$f.tmp" "$f"
done
